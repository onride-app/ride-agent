# Copy separately for each service; fill through your secret manager.
HOST=127.0.0.1
PORT=3333
PUBLIC_BASE_URL=https://mcp.onride.me
RIDE_GRAPHQL_URL=https://YOUR-RIDE-CORE/graphql
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
REDIS_URL=
RIDE_AGENT_BACKEND_URL=http://127.0.0.1:3344
RIDE_AGENT_HUMAN_COOKIE_KEY=
RIDE_AGENT_ENABLED=false
RIDE_AGENT_READ_ONLY=false
RIDE_AGENT_DATABASE_URL=
RIDE_AGENT_CURSOR_KEY=
RIDE_AGENT_EXECUTOR_URL=http://127.0.0.1:3355
RIDE_AGENT_EXECUTOR_TOKEN=
RIDE_AGENT_CORE_URL=https://YOUR-PRIVATE-RIDE-CORE
RIDE_AGENT_CORE_SERVICE_TOKEN=
# Optional authenticated shared Core Info route. Enable after its adapter and
# managed-provider configuration are deployed; failures never fall back locally.
RIDE_AGENT_INFO_READ_ROUTE=official
# Keep disabled until every queue-aware Core reader uses the v2 Lua protocol.
RIDE_AGENT_INFO_FRAME_V2_ENABLED=false
RIDE_AGENT_INFO_FRAME_V2_FLEET_EPOCH=
# Experimental two-physical-egress reads. Keep OFF until all writer/egress,
# original-bank drain and Core/Gateway protocol evidence is verified.
RIDE_AGENT_INFO_FRAME_V3_ENABLED=false
RIDE_AGENT_PREPARED_PROMOTION_V1_ENABLED=false
RIDE_AGENT_INFO_FRAME_V3_AUTHORITY_JSON=
# Gateway role only. Never give this role DB/Redis/Core-service/signing secrets.
RIDE_AGENT_SOURCE_FORWARD_ENABLED=false
RIDE_AGENT_SOURCE_READ_CLIENT_TOKEN=
RIDE_AGENT_SOURCE_FORWARD_KEY_HEX64=
# Core-only observed Gateway deployment pin, independent from stable authority.
RIDE_AGENT_SOURCE_GATEWAY_DEPLOYMENT_ID=
RIDE_AGENT_TRADER_ID_SALT=
RIDE_AGENT_NETWORK=testnet
RIDE_AGENT_PREDICTION_ENABLED=false
RIDE_AGENT_POLYGON_RPC_URL=
RIDE_PUBLIC_SUBMISSION_MODE=false
FIREBASE_SERVICE_ACCOUNT_JSON=
# Reuse existing Ride Firebase configuration (server-only, optional alternative).
FCM_SERVICE_ACCOUNT_JSON_BASE64=
RIDE_AGENT_FCM_PROJECT_ID=

# Independent Agent RWA services, never the old App worker.
RIDE_AGENT_RWA_ENABLED=false
RIDE_AGENT_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Manual read-only proof command only; never started by Agent/backend/bridge.
# Uses a dedicated archive RPC budget. Checkpoints and their separate .key file
# contain private wallet inventory and must remain outside the repository.
RIDE_PREDICTION_INVENTORY_PROOF_ENABLED=false
RIDE_PREDICTION_INVENTORY_CHECKPOINT=
RIDE_PREDICTION_INVENTORY_OWNER=
RIDE_PREDICTION_INVENTORY_PROVIDER_POLICY=
RIDE_PREDICTION_INVENTORY_RPC_URL=

# App-owned Agent integration. Gateway can use App HTTPS for both business APIs
# and durable OAuth/human-handoff storage; leave unset for legacy Redis mode.
RIDE_AGENT_APP_SESSION_URL=
RIDE_AGENT_APP_SESSION_TOKEN=
# Only the private App API may activate the managed business module. Enabling
# this process preserves the existing portfolio authorization and Core gates.
RIDE_AGENT_APP_RUNTIME_ENABLED=false
RIDE_AGENT_APP_SESSION_STORE_ENABLED=false
RIDE_AGENT_APP_BACKEND_PORT=3344
RIDE_AGENT_APP_BRIDGE_PORT=3355
RIDE_AGENT_APP_SESSION_PORT=3366
