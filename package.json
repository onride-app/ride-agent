{
  "name": "@onride/agent",
  "version": "0.5.3",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "node scripts-build-ui.mjs && tsc",
    "start": "node dist/start.js",
    "test": "tsx --test src/*.test.ts src/agent/*.test.ts src/cli/*.test.ts",
    "test:functional": "npm run build && tsx scripts/functional-acceptance.ts",
    "preview:cards": "npm run build && tsx scripts/conversational-preview.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start:backend": "node dist/backend.js",
    "start:bridge": "node dist/bridge.js",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx src/server.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "ws": "8.21.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "8.18.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Rider helps you discover traders, build a personalized copy-trading portfolio, and start copying after your confirmation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onride-app/ride-agent.git"
  },
  "homepage": "https://github.com/onride-app/ride-agent#readme",
  "bugs": {
    "url": "https://github.com/onride-app/ride-agent/issues"
  },
  "bin": {
    "ride": "dist/cli.js"
  },
  "files": [
    "dist",
    "public/agent.html",
    "public/app-auth.css",
    "public/OFL-Poppins.txt",
    "public/confirm.html",
    "public/fund.html",
    "public/fund-demo.html",
    "skills",
    "README.md",
    "LICENSE",
    "docs",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  }
}
